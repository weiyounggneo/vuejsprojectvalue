def manage_exception_automated(context, vprojname):  
    '''
    This is the entry point for DAGs with any alerts/errors.
    It is meant as a on_failure_callback for DAGS.
    Context is an airflow dictionary sent automatically.
    Reference: https://airflow.apache.org/docs/apache-airflow/stable/templates-ref.html (For the Context Dictionary)

    Logic: 
    1) Parse the DAG's context
    2) Log into t_app_job_log (Depending on the whether it is ERROR/ALERT)
    3) Check whether to send email (Depending on t_dags_to_monitor). If dag is not in t_dags_to_monitor, we send the alert immediately (if it is not a weekend). Else, batch the alerts.
    '''

    ##########################################################
    # Step 1: Parse the Context to pull out Exception Type, Message, Start Date and Email List.
    ##########################################################

     # For checking what is passed in airflow context
    print("Context dictionary: ", context)
    #Extract the recipients - This must be set properly in default_args in the parent DAG
    email_list = context['dag'].default_args['email']
    # Extract the DAG_ID from the context.
    vdag_id = context['dag'].dag_id
    #Assumption: Server Time Zone is in UTC+0
    dag_start_date = context['dag_run'].start_date.astimezone(ZoneInfo("Europe/Paris"))
    #Remove TZ info
    dag_start_date = dag_start_date.replace(tzinfo=None)

    # Extract the Exception
    e = context.get("exception")
    #Extract the message
    vexception = str(e)[0:300] 
    # Extract the exception type
    exception_type = type(e).__name__
    print(f"Exception type: {exception_type}") # Print for debugging
    print(f"Exception Message: {vexception}") # Print for debugging


    dag_end_date = datetime.now() 

    ##########################################################
    # Step 2: Log the Error/Alert into t_app_job_log and prepare email title + body
    ##########################################################

    ### This if-else branch checks if this exception is an Alert or an Error. either way, we insert an entry into the Airflow DB for tracking purposes.
    
    if isinstance(e, AirflowAlertException):
        # The error is an AirflowAlertException. There is an alert.
        airflow_site = 'MLT'
        category = e.category
        severity = e.severity

        # Insert an Alert to t_app_job_log
        insert_job_log_alert(vprojname, dag_start_date, dag_end_date, vdag_id, vexception, category, severity, exception_type)

        if severity == 1:
            print(f"Critical Alert Detected (Severity 1). Generating Codex Incident...")
            create_codex_incident(vdag_id, vexception, dag_start_date.strftime('%Y-%m-%d %H:%M:%S'), vprojname)
        else:
            print(f"Alert Detected (Severity {severity}). Skipping Codex Incident creation.")
   


        email_title = "Airflow ALERT: " + "- " + vdag_id
        email_body = f"""
            Alert logged.<br>
            Project: {vprojname}<br>
            Dag ID : {vdag_id}<br>
            Alert Message: {vexception}<br>
            Category: {category}<br>
            Severity: {severity}<br>
            <br>
            <br>
            <i>Receiving too many alerts? Please acknowledge them and Pause the DAG </i>
            <a href="http://muasxv4106.mua.st.com:3000/alerts/update-dag/dag_id={vdag_id}&airflow_site={airflow_site}">Here</a>
    
            """
    elif isinstance(e, AirflowThresholdException):
        # ---------------------------------------------------------
        # NEW LOGIC: Handle Threshold-Based DAGs (e.g., Ansible Monitors)
        # ---------------------------------------------------------
        print(f"Threshold breach detected for {e.server_name}. Generating Automated Codex Incident...")
        
        insert_job_log_alert(vprojname, dag_start_date, dag_end_date, vdag_id, e.generated_message, "Infrastructure", e.severity, exception_type)
        # 1. Format the strings for Codex
        # Extract the first 5 characters of the server (e.g., 'kirsx00301.kir.st.com' -> 'kirsx')
        short_server = e.server_name[:5]
        clean_mount = e.metric_name.replace('/', '-').strip('-')
        if not clean_mount: clean_mount = "root"
        unique_ticket_id = f"{vdag_id}_{short_server}_{clean_mount}" 
        
        # Note the two spaces before each \n This forces Codex Markdown to render the line breaks.
        ticket_msg = (
            f"Automated ticket.\n\n"
            f"DAG: {vdag_id}  \n"
            f"Error: CRITICAL METRIC ALERT  \n"
            f"Server: {e.server_name}  \n"
            f"Site: {e.site_name}  \n"
            f"Mount: {e.metric_name}  \n"
            f"Usage: {e.current_value}%  \n"
            f"Time: {dag_start_date.strftime('%Y-%m-%d %H:%M:%S')}"
        )
        #  2. ONLY Fire the Codex function if it is a Critical Alert
        if e.severity == 1:
            print("Severity 1: Generating Automated Codex Incident...")
            create_codex_incident(
                vdag_id=unique_ticket_id, 
                error_message=ticket_msg, 
                execution_date=dag_start_date.strftime('%Y-%m-%d %H:%M:%S'), 
                vprojname=vprojname,
                site_name=e.site_name
            )
        else:
            print(f"Severity {e.severity}: Skipping Codex ticket creation.")
        
        # 3. Format the Email Alert
        email_title = f"Airflow METRIC ALERT: - {vdag_id} - {e.server_name}"
        email_body = f"""
            Threshold breach logged.<br>
            Project: {vprojname}<br>
            Dag ID : {vdag_id}<br>
            Server: {e.server_name}<br>
            Metric: {e.metric_name}<br>
            Current Value: {e.current_value}% (Limit: {e.threshold_limit}%)<br>
            """
    else:
        # There is a general ERROR in the Airflow DAG. This means Maintenance Team should check.

        # Insert a Failure to t_app_job_log
        insert_job_log_failure(vprojname, dag_start_date, dag_end_date, vdag_id, vexception, exception_type)
        email_title = "Airflow ERROR: " + "- " + vdag_id
        email_list = "TMQ_MDS_Backend_Maintenance_Team@list.st.com" #Alter the recipients to ourselves only.
        #email_list = 'laykoon.png-ext@st.com'
        # email_list='deyuan.chong-ext@st.com'
        email_body = f"""
                There is an error in the following DAG. Maintenance Team, please check.<br>
                Error logged. <br>
                Project: {vprojname}<br>
                Dag ID : {vdag_id}<br>
                Error Message: {vexception}<br>
                Exception Type: {exception_type}<br>
                """
    
    ##########################################################
    # Step 3: Determine whether to send an email immediately or rely on global email alert.
    ##########################################################

    # If the vdag_id is in managed_dags, global_email_alert takes care of it.
    managed_dags = get_managed_dags()

    # Else, we need to handle the email alerts in this callback.
    if vdag_id not in managed_dags:

        ### This if-else branch checks if this is a weekday/weekend and performs summarization if it is a weekend.
        day_of_week = dag_start_date.weekday()
        print("Day of Week: ", day_of_week)

        minute_start = dag_start_date.minute # Minute that the DAG was first started
        print("Minute that the DAG was started: ", minute_start)

        # Check if the current day is a weekday (Monday=0, Sunday=6)
        if day_of_week < 5:
            print("Weekday Logic, sending email without summary")
            send_email(email_list, email_title, email_body)
        
        # Check if the current day is a weekend (Saturday=5, Sunday=6) and the minute is less than 3 (first run of the hour)
        elif day_of_week >= 5 and minute_start <= 3:
            print("Weekend Logic, sending email hourly with summary")

            table_records = get_last_hour_summary(vdag_id, dag_start_date)

            print("Number of Summarized Records: ", len(table_records))

            print(table_records)
            summary_table = tabulate(table_records,
                                    headers=["Project Name","DAG Start Date", "DAG End Date","DAG Id", "Category", "Severity",  "Message", "Status", "Exception Type"],
                                    tablefmt='html')

            

            #Beautifying the table                                     
            summary_table = "<style>table, th, td {border: 1px solid black; border-collapse: collapse;} th, td {padding: 5px;} th {text-align: left;} </style>" + summary_table 
            email_title = "[Weekend Summary] - " + email_title
            email_body = f"""
                        [Past Hour Summary]<br>
                        Last Hour summary of Project: {vprojname} | Dag ID : {vdag_id} (Latest Monitoring First)<br><br>
                        {summary_table}
                        """

            send_email(email_list, email_title, email_body)
        else:
            pass # Don't send any emails if its not on a weekday and the first hour of the weekend.
    


