def close_codex_incident(artifact_id):
    """
    Closes a specific Codex ticket via PUT request using its Artifact ID.
    """
    if not artifact_id:
        print("No artifact ID provided to close.")
        return

    try:
        url = f'https://codex.cro.st.com/api/artifacts/{artifact_id}'
        
        headers = {
            'Content-type': 'application/json',
            'X-Auth-AccessKey': Variable.get("codex_api_key") 
        }
        
        # Payload to update the Status field to 'Closed'
        # Note: 1004834 is your Status field. 
        # Ensure 907056 matches your actual Tuleap ID for the "Closed"  status dropdown!
        payload = {
            "values": [
                {
                    "field_id": 1004834,  # Status
                    "bind_value_ids": [907056]   # ID for Closed 
                }
            ]
        }

        response = requests.put(url, headers=headers, data=json.dumps(payload), verify=False)
        response.raise_for_status()
        
        print(f"Successfully closed Codex ticket #{artifact_id}")
        
    except Exception as e:
        print(f"Failed to close Codex ticket #{artifact_id}: {e}")

