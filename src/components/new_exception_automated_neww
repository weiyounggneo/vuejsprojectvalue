class AirflowAlertException(Exception):
    '''
    Inherits from the base exception class from Python. We are adding Category <str> and Severity <int> to the alert message.
    Example Use: raise AirflowAlertException("More than 3 Watchdog Scripts are running. Please check.","Output Data Freshness",1)

    Valid Categories = "Input Data Freshness", "Output Data Freshness", "Data Pipeline", "Data Quality", "Others", "Model Performance", "Error Log Detected"

    Valid Severities = 1 (Immediate Action Required), 2 (Investigation by Developer and MNT Team), 3 (Investigation by MNT Team), 4 (Automatic Recovery)
    '''
    VALID_CATEGORIES = [
        "Input Data Freshness",
        "Output Data Freshness",
        "Data Pipeline",
        "Data Quality",
        "Model Performance",
        "Error Log Detected",
        "Others"
    ]

    VALID_SEVERITIES = [1,2,3,4]

    def __init__(self, message: str, category: str, severity: int):

        if not isinstance(category, str):
            raise TypeError(f"Expected 'category' to be a string, got {type(category).__name__}")
        if category not in self.VALID_CATEGORIES:
            raise ValueError(f"Invalid category '{category}'. Valid categories are: {', '.join(self.VALID_CATEGORIES)}")
        if not isinstance(severity, int):
            raise TypeError(f"Expected 'severity' to be an integer, got {type(severity).__name__}")
        if severity not in self.VALID_SEVERITIES:
            raise ValueError(f"Invalid severity '{severity}'. Valid severity values are: {', '.join(self.VALID_SEVERITIES)}")

        super().__init__(message)
        self.category = category
        self.severity = severity



class AirflowThresholdException(Exception):
    """
    Custom exception for metric breaches (e.g., Disk Space, CPU usage). 
    """
    # 👇 Added severity: int = 1 to the parameters
    def __init__(self, metric_name: str, current_value: float, threshold_limit: float, server_name: str, site_name: str = None, severity: int = 1):
        self.metric_name = metric_name
        self.current_value = current_value
        self.threshold_limit = threshold_limit
        self.server_name = server_name
        self.site_name = site_name
        self.severity = severity     # <--- Saves the severity for the handler to use!
        
        # Build the standard error message automatically
        self.generated_message = f"THRESHOLD BREACH: {server_name} hit {current_value}% on {metric_name} (Limit: {threshold_limit}%)"
        super().__init__(self.generated_message)



