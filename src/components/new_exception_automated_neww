def check_existing_open_incident(vdag_id):
    """
    Searches Codex to see if an Open/New incident already exists for this DAG.
    Returns True if an open ticket exists, False if not.
    """
    tracker_id = 41068
    # Sorting by most recent first. Limit to 50 to keep the API call fast.
    url = f'https://codex.cro.st.com/api/trackers/{tracker_id}/artifacts?limit=50&order=desc' 
    
    headers = {
        'Content-type': 'application/json',
        'X-Auth-AccessKey': Variable.get("codex_api_key") 
    }
    
    try:
        response = requests.get(url, headers=headers, verify=False)
        response.raise_for_status()
        artifacts = response.json()
        
        for artifact in artifacts:
            title = artifact.get('title', '')
            status = artifact.get('status', '')
            
            # Check if this exact DAG ID is in the ticket title AND the ticket is unresolved
            if vdag_id in title and status in ['New', 'Unconfirmed', 'Reopened']:
                print(f"Alert Deduplication: Open ticket already exists for {vdag_id}. Skipping creation.")
                return artifact.get('id')   # <--- CHANGED: Now returns the Artifact ID
                
        return None  # No existing open tickets found
        
    except Exception as e:
        print(f"Failed to check existing tickets: {e}. Defaulting to create new ticket.")
        return False # If the search fails, default to False so we still generate an alert


