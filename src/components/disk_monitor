def insert_run_failures(dag_id, dag_startdate, event_type, server_name, 
                       metric_name, metric_value, alert_type, details):       
    """Log complete event details to audit trail"""
    db_conn = None
    db_cursor = None

    try:
        db_conn = init_db_airflow()
        db_cursor = db_conn.cursor(buffered=True)
        
        error_msg = (f"{event_type}: {server_name} - {metric_name} = {metric_value}% "
                    f"({alert_type}) - {details}")
        
        insert_qry = f"""
            INSERT INTO {failures_table} 
            (DAG_id, DAG_StartDate, ErrorMsg) 
            VALUES (%s, %s, %s)
        """
        db_cursor.execute(insert_qry, (dag_id, dag_startdate, error_msg))
        db_conn.commit()
        print(f"📋 {error_msg}")
    except Exception as err:
        print(f"❌ Error in insert_run_failures: {err}")
        traceback.print_exc()
        raise
    finally:
        try:
            if db_cursor:
                db_cursor.close()
        except Exception:
            pass
        try:
            if db_conn:
                db_conn.close()
        except Exception:
            pass


# ============== MAIN MONITORING TASK ==============
@task
def monitor_servers_disks(**kwargs):
    """Main monitoring task"""
    db_conn_proj = None
    db_cursor_proj = None

    try:
        print("=" * 60)
        print("🚀 STARTING DISK SPACE MONITORING")
        print("=" * 60)
        
        # ✅ NEW: Two-Way Sync! Poll Codex to see if humans closed any FIXED tickets
        poll_codex_for_closures()

        db_conn_proj = init_db_proj('mysql_ansible')
        db_cursor_proj = db_conn_proj.cursor(buffered=True)

        dag_end_date = datetime.now()
       
        all_disk_qry = f"""
            SELECT t1.server_name, t1.filesystem, t1.size, t1.used, t1.avail, t1.use_percent, t1.mounted_on, t1.execution_date
            FROM {disk_table} t1
            JOIN (
                SELECT server_name, mounted_on, MAX(execution_date) AS max_date
                FROM {disk_table}
                GROUP BY server_name, mounted_on
            ) t2
            ON t1.server_name = t2.server_name
            AND t1.mounted_on = t2.mounted_on
            AND t1.execution_date = t2.max_date
            WHERE t1.mounted_on NOT LIKE '%/.snapshot/%'
            ORDER BY t1.server_name, t1.use_percent DESC;
        """

        print(f"🔍 Executing query for latest disk metrics...")
        db_cursor_proj.execute(all_disk_qry)
        records = db_cursor_proj.fetchall()

        if not records:
            print("⚠️  No disk metrics found in database")
            insert_job_log_alert(
                vprojname,
                dag_start_date,
                dag_end_date,
                vdag_id,
                "Monitor Disks",
                "No disk metrics available",
                1,
                None
            )
            return

        print(f"✓ Found {len(records)} disk metric records")

        # ✅ AGGREGATED BY SITE
        sites_with_new_alerts = set()
        sites_with_resend_alerts = set()
        sites_with_escalation_alerts = set()
        sites_with_fixes = set()
        
        alerts_by_site = {}
        
        #  TRACKER 
        highest_severity_this_run = 2 # Defaults to warning, upgrades if a critical is found

        print("\n" + "=" * 60)
        print("📊 PROCESSING DISK METRICS")
        print("=" * 60)

        for record in records:
            server_name = record[0]
            filesystem = record[1]
            size = record[2]
            used = record[3]
            avail = record[4]
            use_percent = record[5]
            mounted_on = record[6]
            execution_date = record[7]

            # Skip snapshots7    
            if '/.snapshot/' in mounted_on:        
                print(f"⏭️ Skipping snapshot filesystem: {server_name} - {mounted_on}")    
                continue    
               
            site_name = get_site_from_server_name(server_name)

            print(f"\n📌 {server_name} | {mounted_on} = {use_percent}%")

            # Determine alert type
            if use_percent >= THRESHOLD_CRITICAL:
                alert_type = 'CRITICAL'
                highest_severity_this_run = 1  # <-- Upgrades the DAG severity

            elif use_percent > THRESHOLD_WARNING:
                alert_type = 'WARNING'
            else:
                alert_type = 'NORMAL'

            # Check alert status
            alert_status, alert_info = insert_alert_status(
                server_name,
                site_name,
                mounted_on,
                use_percent,
                THRESHOLD_WARNING,
                THRESHOLD_CRITICAL
            )

            # Initialize site dict if needed
            if site_name not in alerts_by_site:
                alerts_by_site[site_name] = {
                    'servers': {},
                    'new_alerts': [],
                    'resend_alerts': [],
                    'escalation_alerts': [],
                    'fixed_alerts': {}
                }

            # Initialize server dict if needed
            if server_name not in alerts_by_site[site_name]['servers']:
                alerts_by_site[site_name]['servers'][server_name] = {
                    'new_metrics': [],
                    'resend_metrics': [],
                    'escalation_metrics': [],
                    'fixed_metrics': {}
                }

            # Handle alert status
            if alert_status == 'NEW' or alert_status == 'REOPENED':
                sites_with_new_alerts.add(site_name)
                
                alerts_by_site[site_name]['servers'][server_name]['new_metrics'].append({
                    'filesystem': filesystem,
                    'size': size,
                    'used': used,
                    'avail': avail,
                    'use_percent': use_percent,
                    'mounted_on': mounted_on
                })

                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    mounted_on, use_percent, THRESHOLD_WARNING, alert_type,
                    is_fixed=False,
                    is_acknowledged=False
                )

                event_type = 'NEW' if alert_status == 'NEW' else 'REOPENED'
                details = "Disk usage exceeded threshold" if alert_status == 'NEW' else "Disk usage exceeded threshold again (re-triggered)"
                insert_run_failures(vdag_id, dag_start_date, event_type,
                    server_name, mounted_on, use_percent, alert_type, details)

                # ---------------------------------------------------------
                # AUTOMATED CODEX TICKET (NEW)
                # ---------------------------------------------------------
                if use_percent >= THRESHOLD_CRITICAL: 
                    print(f"🚨 CRITICAL THRESHOLD REACHED: Creating Codex ticket for {server_name}")
                    
                    # 1. Truncate the server name for the unique ID
                    short_server = server_name[:5] 
                    clean_mount = mounted_on.replace('/', '-').strip('-')
                    if not clean_mount: clean_mount = "root" 
                    unique_ticket_id = f"{vdag_id}_{short_server}_{clean_mount}" 

                    
                    # 2. Apply the Codex Markdown double-space formatting
                    ticket_msg = (
                        f"Automated ticket.\n\n"
                        f"DAG: {vdag_id}  \n"
                        f"Error: CRITICAL DISK ALERT  \n"
                        f"Server: {server_name}  \n"
                        f"Site: {site_name}  \n"
                        f"Mount: {mounted_on}  \n"
                        f"Usage: {use_percent}%  \n"
                        f"Time: {dag_start_date.strftime('%Y-%m-%d %H:%M:%S')}"
                    )
                    
                    new_id = create_codex_incident(
                        vdag_id=unique_ticket_id, 
                        error_message=ticket_msg, 
                        execution_date=dag_start_date.strftime('%Y-%m-%d %H:%M:%S'), 
                        vprojname=vprojname,
                        site_name=site_name 
                    )
                    # HARDLINK: Save the new ID to the database column
                    if new_id:
                        link_ticket_to_db(server_name, mounted_on, new_id)

            elif alert_status == 'UPDATED':
                sites_with_resend_alerts.add(site_name)
                
                alerts_by_site[site_name]['servers'][server_name]['resend_metrics'].append({
                    'filesystem': filesystem,
                    'size': size,
                    'used': used,
                    'avail': avail,
                    'use_percent': use_percent,
                    'mounted_on': mounted_on
                })

                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    mounted_on, use_percent, THRESHOLD_WARNING, alert_type,
                    is_fixed=False,
                    is_acknowledged=False
                )

                insert_run_failures(vdag_id, dag_start_date, 'RESEND',
                    server_name, mounted_on, use_percent, alert_type,
                    "Alert still active - not acknowledged")

                # ---------------------------------------------------------
                # AUTOMATED CODEX TICKET (RESEND)
                # ---------------------------------------------------------

                # Generate unique ID for searching/creating
                short_server = server_name[:5] 
                clean_mount = mounted_on.replace('/', '-').strip('-')
                if not clean_mount: clean_mount = "root" 
                unique_ticket_id = f"{vdag_id}_{short_server}_{clean_mount}"

                if use_percent >= THRESHOLD_CRITICAL: 
                    print(f"🚨 CRITICAL THRESHOLD REACHED: Creating Codex ticket for {server_name}")
                    
                    ticket_msg = (
                        f"Automated ticket.\n\n"
                        f"DAG: {vdag_id}  \n"
                        f"Error: CRITICAL DISK ALERT  \n"
                        f"Server: {server_name}  \n"
                        f"Site: {site_name}  \n"
                        f"Mount: {mounted_on}  \n"
                        f"Usage: {use_percent}%  \n"
                        f"Time: {dag_start_date.strftime('%Y-%m-%d %H:%M:%S')}"
                    )
                    
                    new_id = create_codex_incident(
                        vdag_id=unique_ticket_id, 
                        error_message=ticket_msg, 
                        execution_date=dag_start_date.strftime('%Y-%m-%d %H:%M:%S'), 
                        vprojname=vprojname,
                        site_name=site_name 
                    )
                    if new_id:
                        link_ticket_to_db(server_name, mounted_on, new_id)
                else:
                    # USAGE IS BETWEEN 86% and 94% (Warning territory)
                    # Resolve the critical ticket from a previous run (keeps ticket ID linked)
                    resolve_and_keep_ticket(server_name, mounted_on, 'OPEN')
                    

            elif alert_status == 'ACKNOWLEDGED_ESCALATED':
                sites_with_escalation_alerts.add(site_name)
                
                alerts_by_site[site_name]['servers'][server_name]['escalation_metrics'].append({
                    'filesystem': filesystem,
                    'size': size,
                    'used': used,
                    'avail': avail,
                    'use_percent': use_percent,
                    'mounted_on': mounted_on
                })

                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    mounted_on, use_percent, THRESHOLD_WARNING, alert_type,
                    is_fixed=False,
                    is_acknowledged=False
                )

                insert_run_failures(vdag_id, dag_start_date, 'ESCALATION',
                    server_name, mounted_on, use_percent, alert_type,
                    "Acknowledged alert metric increased - Reopened")
                
                

                # ---------------------------------------------------------
                # AUTOMATED CODEX TICKET (ESCALATION)
                # ---------------------------------------------------------
                if use_percent >= THRESHOLD_CRITICAL: 
                    print(f"🚨 CRITICAL THRESHOLD REACHED: Creating Codex ticket for {server_name}")
                    
                    short_server = server_name[:5] 
                    clean_mount = mounted_on.replace('/', '-').strip('-')
                    if not clean_mount: clean_mount = "root" 
                    unique_ticket_id = f"{vdag_id}_{short_server}_{clean_mount}"
                    
                    ticket_msg = (
                        f"Automated ticket.\n\n"
                        f"DAG: {vdag_id}  \n"
                        f"Error: CRITICAL DISK ALERT  \n"
                        f"Server: {server_name}  \n"
                        f"Site: {site_name}  \n"
                        f"Mount: {mounted_on}  \n"
                        f"Usage: {use_percent}%  \n"
                        f"Time: {dag_start_date.strftime('%Y-%m-%d %H:%M:%S')}"
                    )
                    
                    new_id = create_codex_incident(  
                        vdag_id=unique_ticket_id, 
                        error_message=ticket_msg, 
                        execution_date=dag_start_date.strftime('%Y-%m-%d %H:%M:%S'), 
                        vprojname=vprojname,
                        site_name=site_name 
                    )

                    if new_id:
                        link_ticket_to_db(server_name, mounted_on, new_id)

            

            elif alert_status == 'ACKNOWLEDGED_STILL_HIGH':
                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    mounted_on, use_percent, THRESHOLD_WARNING, alert_type,
                    is_fixed=False,
                    is_acknowledged=True
                )

                insert_run_failures(vdag_id, dag_start_date, 'ACKNOWLEDGED',
                    server_name, mounted_on, use_percent, alert_type,
                    "Alert acknowledged - no email sent")

                if use_percent < THRESHOLD_CRITICAL:
                    # USAGE IS BETWEEN 86% and 94% (Warning territory)
                    # Resolve the critical ticket since the emergency has passed
                    resolve_and_keep_ticket(server_name, mounted_on, 'OPEN')

            elif alert_status == 'FIXED':
                sites_with_fixes.add(site_name)
                
                if server_name not in alerts_by_site[site_name]['servers']:
                    alerts_by_site[site_name]['servers'][server_name] = {
                        'new_metrics': [],
                        'resend_metrics': [],
                        'escalation_metrics': [],
                        'fixed_metrics': {}
                    }
                
                alerts_by_site[site_name]['servers'][server_name]['fixed_metrics'][mounted_on] = use_percent

                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    mounted_on, use_percent, THRESHOLD_WARNING, alert_type,
                    is_fixed=True,
                    is_acknowledged=False
                )

                insert_run_failures(vdag_id, dag_start_date, 'FIXED',
                    server_name, mounted_on, use_percent, alert_type,
                    "Disk usage fell below threshold (Auto-Fixed)")
                
                # ---------------------------------------------------------
                # AUTOMATED CODEX TICKET (AUTO-RESOLVE)
                # ---------------------------------------------------------
                resolve_and_keep_ticket(server_name, mounted_on, 'FIXED')


        # ✅ Send emails by type
        print("\n" + "=" * 60)
        print("📧 SENDING EMAILS")
        print("=" * 60)
        
        for site in sites_with_new_alerts:
            alert_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['new_metrics']:
                    alert_servers[server_name] = {'metrics': metrics['new_metrics']}
            
            if alert_servers:
                send_alert_email_per_site(site, alert_servers, dag_start_date, email_type='NEW')

        for site in sites_with_resend_alerts:
            alert_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['resend_metrics']:
                    alert_servers[server_name] = {'metrics': metrics['resend_metrics']}
            
            if alert_servers:
                send_alert_email_per_site(site, alert_servers, dag_start_date, email_type='RESEND')

        for site in sites_with_escalation_alerts:
            alert_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['escalation_metrics']:
                    alert_servers[server_name] = {'metrics': metrics['escalation_metrics']}
            
            if alert_servers:
                send_alert_email_per_site(site, alert_servers, dag_start_date, email_type='ESCALATION')

        for site in sites_with_fixes:
            fixed_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['fixed_metrics']:
                    fixed_servers[server_name] = metrics['fixed_metrics']
            
            if fixed_servers:
                send_fixed_email_per_site(site, fixed_servers, dag_start_date)

        # Count totals
        # ---------------------------------------------------------
        # ACCURATE IN-MEMORY COUNTING LOGIC
        # ---------------------------------------------------------
        # Count totals directly from our populated Python dictionaries
        # This completely avoids database date/timezone mismatches!
        
        new_count = sum(
            len(metrics['new_metrics'])
            for site_data in alerts_by_site.values()
            for metrics in site_data['servers'].values()
        )
        
        resend_count = sum(
            len(metrics['resend_metrics']) + len(metrics['escalation_metrics'])
            for site_data in alerts_by_site.values()
            for metrics in site_data['servers'].values()
        )
        
        fixed_count = sum(
            len(metrics['fixed_metrics'])
            for site_data in alerts_by_site.values()
            for metrics in site_data['servers'].values()
        )
        
        # ---------------------------------------------------------
        # UPDATED SEVERITY LOGGING LOGIC
        # ---------------------------------------------------------
        message = f"New alerts: {new_count}, Resent: {resend_count}, Fixed: {fixed_count}"
        
        print("\n" + "=" * 60)
        print("📋 LOGGING RESULTS")
        print("=" * 60)

        if (new_count + resend_count) > 0:
            # We have active alerts (Warning or Critical)
            print(f"Status: WARNING/CRITICAL")
            print(f"Message: {message}")
            
            insert_job_log_alert(
                vprojname,
                dag_start_date,
                dag_end_date,
                vdag_id,
                message,          
                "Monitor Disks", 
                highest_severity_this_run,       # <--- uses the tracker!
                "AirflowThresholdException"
            )
        else:
            # Everything is completely NORMAL! No alerts.
            print(f"Status: SUCCESS")
            print(f"Message: {message}")
            
            # Standard SQL insert for a PASS. Defaults to Severity = NULL.
            try:
                db_conn_success = init_db_airflow()
                db_cursor_success = db_conn_success.cursor()
                
                insert_pass_qry = """
                    INSERT INTO t_app_job_log 
                    (ProjName, DAG_StartDate, DAG_EndDate, DAG_id, Status, Message) 
                    VALUES (%s, %s, %s, %s, 'PASS', %s)
                """
                db_cursor_success.execute(insert_pass_qry, (vprojname, dag_start_date, dag_end_date, vdag_id, message))
                db_conn_success.commit()
            except Exception as e:
                print(f"Failed to log success: {e}")
            finally:
                if 'db_cursor_success' in locals(): db_cursor_success.close()
                if 'db_conn_success' in locals(): db_conn_success.close()

        print(f"\n✅ Monitoring complete. {message}")
        print("=" * 60)


    except Exception as err:
        print(f"\n❌ Error in monitor_servers_disks: {err}")
        traceback.print_exc()

        insert_job_log_alert(
            vprojname,
            dag_start_date,
            datetime.now(),
            vdag_id,
            f"DAG execution failed: {str(err)}",
            "Monitor Disks",
            3,
            "AirflowException"
        )

        insert_run_failures(vdag_id, dag_start_date, 'ERROR', 'DAG', 'N/A', 0, 'ERROR', str(err))
        raise
    finally:
        try:
            if db_cursor_proj:
                db_cursor_proj.close()
        except Exception:
            pass
        try:
            if db_conn_proj:
                db_conn_proj.close()
        except Exception:
            pass


