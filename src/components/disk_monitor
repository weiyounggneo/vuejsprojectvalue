# ============== ALERT STATUS MANAGEMENT ==============
def insert_alert_status(server_name, site_name, mounted_on, use_percent, threshold_warning, threshold_critical):
    """
    Manage alert status with refined logic
    Uses buffered=True cursor to avoid MySQL connector issues
    
    Returns:
        ('NEW', dict) - New alert created
        ('UPDATED', None) - OPEN alert, still high, resend email
        ('ACKNOWLEDGED_STILL_HIGH', None) - ACK alert, metric didn't increase, no email
        ('ACKNOWLEDGED_ESCALATED', None) - ACK alert, metric increased, reopen and send escalation
        ('FIXED', dict) - Alert metrics normal, awaiting manual closure
        ('REOPENED', None) - FIXED/CLOSED alert re-triggered
        ('NORMAL', None) - Below threshold, no action
    """
    db_conn = None
    db_cursor = None

    try:
        db_conn = init_db_airflow()
        db_cursor = db_conn.cursor(buffered=True)

        # Check for EXISTING alert (OPEN, ACKNOWLEDGED, or FIXED)
        check_qry = f"""
            SELECT alert_id, status, metric_value 
            FROM {alert_status_table}
            WHERE server_name = %s 
              AND metric_name = %s 
              AND status IN ('OPEN', 'ACKNOWLEDGED', 'FIXED')
        """
        db_cursor.execute(check_qry, (server_name, mounted_on))
        existing_alert = db_cursor.fetchone()

        # ========== USAGE IS HIGH (> 85%) ==========
        if use_percent > threshold_warning:
            
            if existing_alert:
                alert_id, status, prev_metric_value = existing_alert
                
                # ===== OPEN STATE =====
                if status == 'OPEN':
                    update_qry = f"""
                        UPDATE {alert_status_table}
                        SET metric_value = %s, 
                            threshold = %s,
                            last_alert_time = %s
                        WHERE alert_id = %s
                    """
                    db_cursor.execute(update_qry, (use_percent, threshold_warning, datetime.now(), alert_id))
                    db_conn.commit()
                    print(f"🔄 UPDATED (OPEN): {server_name} - {mounted_on} = {use_percent}% - RESEND EMAIL")
                    return ('UPDATED', None)
                
                # ===== ACKNOWLEDGED STATE =====
                elif status == 'ACKNOWLEDGED':
                    metric_increased = prev_metric_value and use_percent > prev_metric_value
                    
                    if metric_increased:
                        update_qry = f"""
                            UPDATE {alert_status_table}
                            SET metric_value = %s, 
                                threshold = %s,
                                status = 'OPEN',
                                acknowledged_by = NULL,
                                acknowledged_at = NULL,
                                last_alert_time = %s
                            WHERE alert_id = %s
                        """
                        db_cursor.execute(update_qry, (use_percent, threshold_warning, datetime.now(), alert_id))
                        db_conn.commit()
                        print(f"🔴 ESCALATED (from ACK): {server_name} - {mounted_on} = {use_percent}% - SEND ESCALATION EMAIL")
                        return ('ACKNOWLEDGED_ESCALATED', None)
                    else:
                        update_qry = f"""
                            UPDATE {alert_status_table}
                            SET metric_value = %s, 
                                threshold = %s
                            WHERE alert_id = %s
                        """
                        db_cursor.execute(update_qry, (use_percent, threshold_warning, alert_id))
                        db_conn.commit()
                        print(f"⏸️  ACKNOWLEDGED_STILL_HIGH: {server_name} - {mounted_on} = {use_percent}% - NO EMAIL")
                        return ('ACKNOWLEDGED_STILL_HIGH', None)

                # ===== FIXED STATE (Re-spike) =====
                elif status == 'FIXED':
                    update_qry = f"""
                        UPDATE {alert_status_table}
                        SET metric_value = %s, 
                            threshold = %s,
                            status = 'OPEN',
                            last_alert_time = %s
                        WHERE alert_id = %s
                    """
                    db_cursor.execute(update_qry, (use_percent, threshold_warning, datetime.now(), alert_id))
                    db_conn.commit()
                    print(f"🔴 RE-ESCALATED (from FIXED): {server_name} - {mounted_on} = {use_percent}%")
                    return ('REOPENED', {
                        'server_name': server_name,
                        'mounted_on': mounted_on,
                        'use_percent': use_percent
                    })
            
            else:
                # Check if CLOSED alert exists
                check_closed = f"""
                    SELECT alert_id FROM {alert_status_table}
                    WHERE server_name = %s 
                      AND metric_name = %s 
                      AND status = 'CLOSED'
                """
                db_cursor.execute(check_closed, (server_name, mounted_on))
                closed_alert = db_cursor.fetchone()
                
                if closed_alert:
                    insert_qry = f"""
                        INSERT INTO {alert_status_table}
                        (server_name, site_name, dag_id, alert_type, metric_name, metric_value, threshold, status, first_alert_time, last_alert_time)
                        VALUES (%s, %s, %s, 'DISK', %s, %s, %s, 'OPEN', %s, %s)
                    """
                    db_cursor.execute(insert_qry, (
                        server_name, site_name, vdag_id, mounted_on, use_percent, threshold_warning,
                        datetime.now(), datetime.now()
                    ))
                    db_conn.commit()
                    print(f"🔴 REOPENED (from CLOSED): {server_name} - {mounted_on} = {use_percent}%")
                    return ('REOPENED', {
                        'server_name': server_name,
                        'mounted_on': mounted_on,
                        'use_percent': use_percent
                    })
                else:
                    insert_qry = f"""
                        INSERT INTO {alert_status_table}
                        (server_name, site_name, dag_id, alert_type, metric_name, metric_value, threshold, status, first_alert_time, last_alert_time)
                        VALUES (%s, %s, %s, 'DISK', %s, %s, %s, 'OPEN', %s, %s)
                    """
                    db_cursor.execute(insert_qry, (
                        server_name, site_name, vdag_id, mounted_on, use_percent, threshold_warning,
                        datetime.now(), datetime.now()
                    ))
                    db_conn.commit()
                    print(f"🆕 NEW ALERT: {server_name} - {mounted_on} = {use_percent}%")
                    return ('NEW', {
                        'server_name': server_name,
                        'mounted_on': mounted_on,
                        'use_percent': use_percent
                    })
        
        # ========== USAGE IS NORMAL (<= 85%) ==========
        else:
            if existing_alert:
                alert_id, status, _ = existing_alert
                
                # ONLY auto-fix if it's currently OPEN or ACKNOWLEDGED
                if status in ['OPEN', 'ACKNOWLEDGED']:
                    fix_qry = f"""
                        UPDATE {alert_status_table}
                        SET metric_value = %s, 
                            threshold = %s,
                            status = 'FIXED', 
                            last_alert_time = %s
                        WHERE alert_id = %s
                    """
                    db_cursor.execute(fix_qry, (use_percent, threshold_warning, datetime.now(), alert_id))
                    db_conn.commit()
                    print(f"✅ FIXED: {server_name} - {mounted_on} = {use_percent}%")
                    
                    return ('FIXED', { 
                        'server_name': server_name,
                        'mounted_on': mounted_on,
                        'use_percent': use_percent
                    })
                elif status == 'FIXED':
                    return ('NORMAL', None)
            else:
                print(f"✔️  NORMAL: {server_name} - {mounted_on} = {use_percent}%")
                return ('NORMAL', None)

    except Exception as err:
        print(f"❌ Error in insert_alert_status: {err}")
        traceback.print_exc()
        raise
    finally:
        try:
            if db_cursor:
                db_cursor.close()
        except Exception:
            pass
        try:
            if db_conn:
                db_conn.close()
        except Exception:
            pass


def poll_codex_for_closures():
    """
    Two-Way Sync: Queries DB for 'FIXED' alerts waiting on a human. 
    Polls the Codex API to see if a human changed it to 'Closed'.
    If yes, updates the Airflow DB to 'CLOSED' and unlinks the ticket.
    """
    try:
        conn = init_db_airflow()
        cursor = conn.cursor(buffered=True)
        
        # Find all FIXED alerts that are still waiting for a human
        cursor.execute(f"""
            SELECT server_name, metric_name, ticket_artifact_id 
            FROM {alert_status_table} 
            WHERE status = 'FIXED' AND ticket_artifact_id IS NOT NULL
        """)
        rows = cursor.fetchall()
        
        if not rows:
            print("✔️ No FIXED tickets awaiting human closure check.")
            return
            
        headers = {
            'Content-type': 'application/json',
            'X-Auth-AccessKey': Variable.get("codex_api_key") 
        }
        
        for row in rows:
            server_name, mounted_on, ticket_id = row
            
            # Fetch ticket details directly from Codex
            url = f'https://codex.cro.st.com/api/artifacts/{ticket_id}'
            response = requests.get(url, headers=headers, verify=False)
            
            if response.status_code == 200:
                artifact = response.json()
                # Safely extract the status field (usually a string like 'Closed')
                status = artifact.get('status', '').lower()
                
                # If the human closed it in Codex!
                if status == 'closed':
                    print(f"📉 TICKETING: Human closure detected in Codex for artifact #{ticket_id} ({server_name} - {mounted_on}). Updating DB to CLOSED.")
                    
                    # 1. Update the Active Status table (Surgical update using the exact ticket_id)
                    cursor.execute(f"""
                        UPDATE {alert_status_table} 
                        SET status = 'CLOSED', ticket_artifact_id = NULL, closed_at = %s 
                        WHERE server_name = %s 
                          AND metric_name = %s 
                          AND ticket_artifact_id = %s 
                          AND status = 'FIXED'
                    """, (datetime.now(), server_name, mounted_on, ticket_id))
                    
                    # 2. Update the Historical Infra table (Surgical update using the exact DAG_id)
                    cursor.execute(f"""
                        UPDATE {alert_infra_table}
                        SET Alert_Status = 'CLOSED'
                        WHERE ServerName = %s 
                          AND Metric_Name = %s 
                          AND DAG_id = %s 
                          AND Alert_Status = 'FIXED'
                    """, (server_name, mounted_on, vdag_id))
                    
                    conn.commit()
                else:
                    print(f"⏳ TICKETING: Artifact #{ticket_id} is still '{status}' in Codex. Waiting for human to close.")
            else:
                print(f"⚠️ Failed to fetch status for artifact #{ticket_id}. Status Code: {response.status_code}")
                
    except Exception as e:
        print(f"❌ Failed to poll Codex for closures: {e}")
    finally:
        if 'cursor' in locals(): cursor.close()
        if 'conn' in locals(): conn.close()


def link_ticket_to_db(server_name, mounted_on, artifact_id):
    """Saves the newly created Artifact ID to the database."""
