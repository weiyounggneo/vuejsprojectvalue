def resolve_and_keep_ticket(server_name, mounted_on, current_status):
    """Finds the saved Artifact ID, resolves it in Codex, and keeps it linked in DB."""
    try:
        conn = init_db_airflow()
        cursor = conn.cursor()
        
        # Look up the saved Artifact ID
        if current_status == 'FIXED':
            cursor.execute("""
                SELECT ticket_artifact_id FROM t_monitor_server_alert_status 
                WHERE server_name = %s AND metric_name = %s AND status = 'FIXED'
            """, (server_name, mounted_on))
        else:
            cursor.execute("""
                SELECT ticket_artifact_id FROM t_monitor_server_alert_status 
                WHERE server_name = %s AND metric_name = %s AND status IN ('OPEN', 'ACKNOWLEDGED', 'FIXED')
            """, (server_name, mounted_on))
            
        row = cursor.fetchone()
        existing_ticket_id = row[0] if row else None
        
        # If an ID exists, resolve it
        if existing_ticket_id:
            print(f"📉 TICKETING: Resolving artifact #{existing_ticket_id} for {server_name} ({mounted_on})")
            resolve_codex_incident(existing_ticket_id)
            # NO UNLINKING: We leave ticket_artifact_id intact for human review
            
    except Exception as e:
        print(f"❌ Failed to resolve DB ticket: {e}")
    finally:
        if 'cursor' in locals(): cursor.close()
        if 'conn' in locals(): conn.close()

# ============== HISTORICAL LOGGING FUNCTION ==============
def insert_or_update_alert_data(server_name, dag_start_date, dag_end_date, dag_id, 
                                 metric_name, metric_value, threshold, alert_status,
                                 is_fixed=False, is_acknowledged=False):
    """
    Insert or update alert data in t_monitor_server_infra

    NEVER create new entries. Only:
    1. INSERT first entry when alert is triggered
    2. UPDATE Email_Sent and Email_Sent_Timestamp when alert continues
    3. UPDATE Alert_Status when fixing/acknowledging
    """
    db_conn = None
    db_cursor = None

    try:
        db_conn = init_db_airflow()
        db_cursor = db_conn.cursor(buffered=True)

        # Check if ANY entry exists for this server/metric (regardless of date)
        check_qry = f"""
            SELECT id, Email_Sent, Alert_Status 
            FROM {alert_infra_table}
            WHERE ServerName = %s 
              AND Metric_Name = %s 
              AND DAG_id = %s
              AND Alert_Status NOT IN ('CLOSED', 'FIXED')
            ORDER BY id DESC
            LIMIT 1
        """
        db_cursor.execute(check_qry, (server_name, metric_name, dag_id))
        existing_log = db_cursor.fetchone()

        if existing_log:
            # Entry already exists - UPDATE it
            record_id = existing_log[0]
            current_email_count = existing_log[1] if existing_log[1] else 1
            current_alert_status = existing_log[2]
            
            # Check alert status in t_monitor_server_alert_status
            check_alert_status_qry = f"""
                SELECT status FROM {alert_status_table}
                WHERE server_name = %s 
                  AND metric_name = %s 
                  AND status IN ('OPEN', 'ACKNOWLEDGED', 'FIXED')
                LIMIT 1
            """
            db_cursor.execute(check_alert_status_qry, (server_name, metric_name))
            alert_status_result = db_cursor.fetchone()
            
            # Determine if we should increment Email_Sent
            should_increment = not is_acknowledged and (not alert_status_result or alert_status_result[0] != 'ACKNOWLEDGED')
            new_email_count = current_email_count if not should_increment else current_email_count + 1

            if is_fixed:
                # ✅ When fixing, set Alert_Status = 'FIXED'
                update_qry = f"""
                    UPDATE {alert_infra_table}
                    SET Email_Sent = %s, 
                        Email_Sent_Timestamp = %s, 
                        Metric_Value = %s,
                        Alert_Threshold = %s,
                        Alert_Status = 'FIXED'
                    WHERE id = %s
                """
                db_cursor.execute(update_qry, (new_email_count, datetime.now(), metric_value, threshold, record_id))
                print(f"📊 FIXED alert: {server_name} - {metric_name} (Email_Sent: {new_email_count}, Timestamp: {datetime.now()})")
            elif should_increment:
                # ✅ Email sent (NEW or RESEND or ESCALATION), increment Email_Sent and update timestamp
                update_qry = f"""
                    UPDATE {alert_infra_table}
                    SET Email_Sent = %s, 
                        Email_Sent_Timestamp = %s, 
                        Metric_Value = %s,
                        Alert_Threshold = %s,
                        Alert_Status = %s
                    WHERE id = %s
                """
                db_cursor.execute(update_qry, (new_email_count, datetime.now(), metric_value, threshold, alert_status, record_id))
                print(f"📊 Updated alert: {server_name} - {metric_name} (Email_Sent: {current_email_count} → {new_email_count}, Timestamp: {datetime.now()})")
            else:
                # ✅ ACKNOWLEDGED - Update metric/threshold and status, but DON'T update Email_Sent or Email_Sent_Timestamp
                update_qry = f"""
                    UPDATE {alert_infra_table}
                    SET Metric_Value = %s,
                        Alert_Threshold = %s,
                        Alert_Status = %s
                    WHERE id = %s
                """
                db_cursor.execute(update_qry, (metric_value, threshold, alert_status, record_id))
                print(f"⏸️  ACKNOWLEDGED alert: {server_name} - {metric_name} (NO Email_Sent increment, NO timestamp update)")
            
            db_conn.commit()
            return 'UPDATED'
        else:
            # NO entry exists - INSERT first entry ONLY
            insert_qry = f"""
                INSERT INTO {alert_infra_table}
                (ServerName, DAG_StartDate, DAG_EndDate, DAG_id, Metric_Name, Metric_Value, 
                 Alert_Threshold, Alert_Status, Email_Sent, Email_Sent_Timestamp)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s, %s)
            """

            db_cursor.execute(insert_qry, (
                server_name,
                dag_start_date,
                dag_end_date,
                dag_id,
                metric_name,
                metric_value,
                threshold,
                alert_status,
                1,
                datetime.now()
            ))
            db_conn.commit()
            print(f"📊 Inserted FIRST entry for alert: {server_name} - {metric_name} (Email_Sent: 1, Timestamp: {datetime.now()})")
            return 'INSERTED'

    except Exception as err:
        print(f"❌ Error in insert_or_update_alert_data: {err}")
        traceback.print_exc()
        raise
    finally:
        try:
            if db_cursor:
                db_cursor.close()
        except Exception:
            pass
        try:
            if db_conn:
                db_conn.close()
        except Exception:
            pass

