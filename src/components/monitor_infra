            pass


# ============== MAIN MONITORING TASK ==============
@task
def monitor_servers_infra(**kwargs):
    """Main monitoring task"""
    db_conn_proj = None
    db_cursor_proj = None

    try:
        print("=" * 60)
        print("🚀 STARTING INFRASTRUCTURE MONITORING")
        print("=" * 60)

        # ✅ NEW: Two-Way Sync! Poll Codex to see if humans closed any FIXED Node Down tickets
        poll_codex_for_closures()

        db_conn_proj = init_db_proj('mysql_ansible')
        db_cursor_proj = db_conn_proj.cursor(buffered=True)

        dag_end_date = datetime.now()

        monitor_qry = f"""
             SELECT t1.instance, t1.metric_name, t1.metric_value, t1.timestamp
             FROM {server_metrics_table} t1
             JOIN (
                SELECT instance, metric_name, MAX(timestamp) AS max_ts
                FROM {server_metrics_table}
                WHERE metric_name IN ('cpu_usage', 'mem_usage', 'gpu_usage', 'gpu_memory', 'node_up')
                GROUP BY instance, metric_name
             ) t2
             ON t1.instance = t2.instance
             AND t1.metric_name = t2.metric_name
             AND t1.timestamp = t2.max_ts
        """

        print(f"🔍 Executing query for latest metrics...")
        db_cursor_proj.execute(monitor_qry)
        records = db_cursor_proj.fetchall()

        if not records:
            print("⚠️  No metrics found in database")
            insert_job_log_alert(
                vprojname,
                dag_start_date,
                dag_end_date,
                vdag_id,
                "No metrics available",
                "Infrastructure",
                3,
                "AirflowException"
            )
