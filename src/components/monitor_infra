        print(f"✓ Found {len(records)} metric records")

        # ✅ AGGREGATED BY SITE
        sites_with_new_alerts = set()
        sites_with_resend_alerts = set()
        sites_with_escalation_alerts = set()
        sites_with_fixes = set()
        
        alerts_by_site = {}

        print("\n" + "=" * 60)
        alerts_by_site = {}
        highest_severity_this_run = 2 # Defaults to warning, upgrades if critical
        print("\n" + "=" * 60)
        print("📊 PROCESSING METRICS")
        print("=" * 60)

        # Added to detect node up/down
        current_time_utc = datetime.utcnow()
        current_time_local = datetime.now()
        current_hour_local = current_time_local.hour

        for record in records:
            server_name = record[0]
            metric_name = record[1]
            metric_value = record[2]
            last_timestamp = record[3]

            site_name = get_site_from_server_name(server_name)
            
            if metric_name == 'node_up':
                age = (current_time_utc - last_timestamp).total_seconds()

                if age > 1800:
                     print(f"🚨 STALE >30min → TREAT AS DOWN: {server_name}")
                     metric_value = 0

                elif metric_value == 0:
                     pass

                elif metric_value == 1:
                     pass

            if metric_name == 'node_up':
                 print(f"\n📌 {server_name} | {metric_name} = {metric_value}")
            else:
                 print(f"\n📌 {server_name} | {metric_name} = {metric_value}%")

            # ✅ SPECIAL handling for node_up
            if metric_name == 'node_up':
               if metric_value == 0:
                  alert_type = 'CRITICAL'
                  highest_severity_this_run = 1 # <--- UPGRADES DAG SEVERITY TO 1
               else:
                  alert_type = 'NORMAL'
            else:

               # Determine alert type
               is_gpu_metric = metric_name in ['gpu_usage', 'gpu_memory']
               is_cpu_metric = metric_name == 'cpu_usage'

               if is_gpu_metric:

                  if metric_value > THRESHOLD_WARNING:
                     sustained = is_gpu_persistently_high(
                       server_name,
                       metric_name,
                       THRESHOLD_WARNING,
                       db_conn_proj
                     )

                     if sustained:
                          if metric_value >= THRESHOLD_CRITICAL:
                              alert_type = 'CRITICAL'
                          else:
                              alert_type = 'WARNING'
                     else:
                          print(f"⏸️ GPU spike ignored (not sustained): {server_name}")
                          alert_type = 'IGNORED'

                  else:
                    alert_type = 'NORMAL'

               elif is_cpu_metric:
                  if metric_value > THRESHOLD_WARNING:
                     sustained = is_cpu_persistently_high(
                       server_name,
                       metric_name,
                       THRESHOLD_WARNING,
                       db_conn_proj
                     )

                     if sustained:
                          if metric_value >= THRESHOLD_CRITICAL:
                              alert_type = 'CRITICAL'
                          else:
                              alert_type = 'WARNING'
                     else:
                          print(f"⏸️ CPU spike ignored (not sustained for 6 polls): {server_name}")
                          alert_type = 'IGNORED'

                  else:
                    alert_type = 'NORMAL'

               else:
                    if metric_value >= THRESHOLD_CRITICAL:
                       alert_type = 'CRITICAL'
                    elif metric_value > THRESHOLD_WARNING:
                       alert_type = 'WARNING'
                    else:
                       alert_type = 'NORMAL'

            if metric_name == 'node_up':
               alert_status, alert_info = insert_alert_status(
                   server_name,
                   site_name,
                   metric_name,
                   metric_value,
                   1,
                   1,
                   alert_type
            )
            else:
               alert_status, alert_info = insert_alert_status(
                    server_name,
                    site_name,
                    metric_name,
                    metric_value,
                    THRESHOLD_WARNING,
                    THRESHOLD_CRITICAL,
                    alert_type
            )

            # Initialize site dict if needed
            if site_name not in alerts_by_site:
                alerts_by_site[site_name] = {
                    'servers': {},
                    'new_alerts': [],
                    'resend_alerts': [],
                    'escalation_alerts': [],
                    'fixed_alerts': {}
                }

            # Initialize server dict if needed
            if server_name not in alerts_by_site[site_name]['servers']:
                alerts_by_site[site_name]['servers'][server_name] = {
                    'new_metrics': [],
                    'resend_metrics': [],
                    'escalation_metrics': [],
                    'fixed_metrics': {}
                }

            # Handle alert status
            if alert_status == 'NEW' or alert_status == 'REOPENED':
                sites_with_new_alerts.add(site_name)
                
                alerts_by_site[site_name]['servers'][server_name]['new_metrics'].append({
                    'metric_name': metric_name,
                    'metric_value': metric_value,
                    'alert_type': alert_type
                })

                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    metric_name, metric_value, THRESHOLD_WARNING, alert_type,
                    is_fixed=False,
                    is_acknowledged=False
                )

                event_type = 'NEW' if alert_status == 'NEW' else 'REOPENED'
                details = "Metric exceeded threshold" if alert_status == 'NEW' else "Metric exceeded threshold again (re-triggered)"
                insert_run_failures(vdag_id, dag_start_date, event_type,
                    server_name, metric_name, metric_value, alert_type, details)

            elif alert_status == 'UPDATED':
               
               last_alert_time = alert_info.get('last_alert_time')
               alert_id = alert_info.get('alert_id')
               should_send = False

               if metric_name == 'node_up':
                   if last_alert_time:
                      if current_time_local - last_alert_time >= RESEND_INTERVAL_NODE:
                           should_send = True
                   else:
                      should_send = True

               else:
                   if current_hour_local in ALLOWED_HOURS_NON_CRITICAL and current_time_local.minute < 5:
                      should_send = True

               if should_send:
                   db_conn_tmp = init_db_airflow()
                   cursor_tmp = db_conn_tmp.cursor()
                   cursor_tmp.execute(f"UPDATE {alert_status_table} SET last_alert_time=%s WHERE alert_id=%s", (datetime.now(), alert_id))
                   db_conn_tmp.commit()
                   cursor_tmp.close()
                   db_conn_tmp.close()

                   sites_with_resend_alerts.add(site_name)
                
                   alerts_by_site[site_name]['servers'][server_name]['resend_metrics'].append({
                       'metric_name': metric_name,
                       'metric_value': metric_value,
                       'alert_type': alert_type
                   })

                   insert_or_update_alert_data(
                       server_name, dag_start_date, dag_end_date, vdag_id,
                       metric_name, metric_value, THRESHOLD_WARNING, alert_type,
                       is_fixed=False,
                       is_acknowledged=False
                   )

                   insert_run_failures(vdag_id, dag_start_date, 'RESEND',
                       server_name, metric_name, metric_value, alert_type,
                       "Alert resend based on policy"
                   )
            
               else:
                   print(f"⏸️  SKIPPED EMAIL: {server_name} - {metric_name} (throttled)")

            elif alert_status == 'ACKNOWLEDGED_ESCALATED':
                sites_with_escalation_alerts.add(site_name)
                
                alerts_by_site[site_name]['servers'][server_name]['escalation_metrics'].append({
                    'metric_name': metric_name,
                    'metric_value': metric_value,
                    'alert_type': alert_type
                })

                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    metric_name, metric_value, THRESHOLD_WARNING, alert_type,
                    is_fixed=False,
                    is_acknowledged=False
                )

                insert_run_failures(vdag_id, dag_start_date, 'ESCALATION',
                    server_name, metric_name, metric_value, alert_type,
                    "Alert escalated - metric increased after acknowledgement")

            elif alert_status == 'ACKNOWLEDGED_STILL_HIGH':
                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    metric_name, metric_value, THRESHOLD_WARNING, alert_type,
                    is_fixed=False,
                    is_acknowledged=True
                )

                insert_run_failures(vdag_id, dag_start_date, 'ACKNOWLEDGED',
                    server_name, metric_name, metric_value, alert_type,
                    "Alert acknowledged - no email sent")

            elif alert_status == 'FIXED':
                sites_with_fixes.add(site_name)
                
                if server_name not in alerts_by_site[site_name]['servers']:
                    alerts_by_site[site_name]['servers'][server_name] = {
                        'new_metrics': [],
                        'resend_metrics': [],
                        'escalation_metrics': [],
                        'fixed_metrics': {}
                    }
                
                alerts_by_site[site_name]['servers'][server_name]['fixed_metrics'][metric_name] = metric_value

                insert_or_update_alert_data(
                    server_name, dag_start_date, dag_end_date, vdag_id,
                    metric_name, metric_value, THRESHOLD_WARNING, alert_type,
                    is_fixed=True,
                    is_acknowledged=False
                )

                insert_run_failures(vdag_id, dag_start_date, 'FIXED',
                    server_name, metric_name, metric_value, alert_type,
                    "Metric returned to normal (Auto-Fixed)")
        

        # ---------------------------------------------------------
        # AUTOMATED CODEX TICKET (DB-BACKED SITE TICKETS)
        # ---------------------------------------------------------
        print("\n" + "=" * 60)
        print("🎫 EVALUATING DB-BACKED SITE TICKETS")
        print("=" * 60)
        
        db_conn_ticket = None
        db_cursor_ticket = None
        total_down_nodes = 0
        try:
            db_conn_ticket = init_db_airflow()
            db_cursor_ticket = db_conn_ticket.cursor(buffered=True)
            
            # 1. Get ALL nodes that are currently DOWN
            db_cursor_ticket.execute("""
                SELECT site_name, server_name
                FROM t_monitor_server_alert_status
                WHERE metric_name = 'node_up'
                  AND status IN ('OPEN', 'ACKNOWLEDGED')
            """)
            down_nodes_by_site = {}
            for row in db_cursor_ticket.fetchall():
                site = row[0].upper() if row[0] else 'UNKNOWN'
                server = row[1]
                if site not in down_nodes_by_site:
                    down_nodes_by_site[site] = []
                down_nodes_by_site[site].append(server)
                total_down_nodes += 1
                
            # 2. Get EXISTING Artifact IDs from your new DB column
            db_cursor_ticket.execute("""
                SELECT site_name, MAX(ticket_artifact_id)
                FROM t_monitor_server_alert_status
                WHERE metric_name = 'node_up'
                  AND ticket_artifact_id IS NOT NULL
                GROUP BY site_name
            """)
            # Creates a dictionary like: {'MALTA': 1604574, 'MUAR': 1604599}
            active_tickets_by_site = {row[0].upper(): row[1] for row in db_cursor_ticket.fetchall() if row[0]}
            
            known_sites = ['MUAR', 'MALTA', 'BOUSKOURA', 'SHENZHEN', 'TOA PAYOH', 'CALAMBA', 'UNKNOWN']
            sites_to_evaluate = set(known_sites + list(down_nodes_by_site.keys()) + list(active_tickets_by_site.keys()))
            
            for site in sites_to_evaluate:
                down_nodes = down_nodes_by_site.get(site, [])
                existing_ticket_id = active_tickets_by_site.get(site)
                
                # SCENARIO A: At least one node is down for this specific site
                if len(down_nodes) > 0:
                    if not existing_ticket_id:
                        print(f"🚨 {site}: {len(down_nodes)} nodes are down. Creating Site Codex Ticket...")
                        
                        down_nodes_list = "\n".join([f"- {node}" for node in down_nodes])
                        ticket_msg = (
                            f"Automated Site Ticket.\n\n"
                            f"DAG: {vdag_id}  \n"
                            f"Error: CRITICAL NODE DOWN ALERT  \n"
                            f"Site: {site}  \n"
                            f"The following servers are currently DOWN:\n"
                            f"{down_nodes_list}  \n\n"
                            f"Time: {dag_start_date.strftime('%Y-%m-%d %H:%M:%S')}"
                        )
                        
                        # Create the ticket AND capture the returned ID
                        new_id = create_codex_incident(
                            vdag_id=f"{vdag_id}_{site}_NODE_DOWN", # Title fallback for humans
                            error_message=ticket_msg, 
                            execution_date=dag_start_date.strftime('%Y-%m-%d %H:%M:%S'), 
                            vprojname=vprojname,
                            site_name=site 
                        )
                        
                        # HARDLINK: Save the new ID to the database column
                        if new_id:
                            db_cursor_ticket.execute("""
                                UPDATE t_monitor_server_alert_status 
                                SET ticket_artifact_id = %s 
                                WHERE site_name = %s 
                                  AND metric_name = 'node_up' 
                                  AND status IN ('OPEN', 'ACKNOWLEDGED')
                            """, (new_id, site))
                            db_conn_ticket.commit()
                            print(f"💾 Saved Artifact ID #{new_id} to database for {site}.")
                    else:
                        print(f"✔️ {site}: Ticket #{existing_ticket_id} is already open in DB. {len(down_nodes)} nodes down.")
                        
                        # Catch-up logic: If Server B goes down after Server A, link Server B to the existing ticket ID
                        db_cursor_ticket.execute("""
                            UPDATE t_monitor_server_alert_status 
                            SET ticket_artifact_id = %s 
                            WHERE site_name = %s 
                              AND metric_name = 'node_up' 
                              AND status IN ('OPEN', 'ACKNOWLEDGED')
                              AND ticket_artifact_id IS NULL
                        """, (existing_ticket_id, site))
                        db_conn_ticket.commit()
                        
                        # 2. Check if NEW servers were actually added to the outage
                        new_servers_added = db_cursor_ticket.rowcount > 0
                        
                        # 3. ONLY update Codex if the situation got WORSE
                        if new_servers_added:
                            print(f"🔄 {site}: New nodes went down. Updating Codex Ticket #{existing_ticket_id}...")
                            
                            down_nodes_list = "\n".join([f"- {node}" for node in down_nodes])
                            updated_ticket_msg = (
                                f"Automated Site Ticket.\n\n"
                                f"DAG: {vdag_id}  \n"
                                f"Error: CRITICAL NODE DOWN ALERT (ESCALATED)  \n"
                                f"Site: {site}  \n"
                                f"The following servers are currently DOWN:\n"
                                f"{down_nodes_list}  \n\n"
                                f"Last Checked: {dag_start_date.strftime('%Y-%m-%d %H:%M:%S')}"
                            )
                            
                            update_codex_incident(existing_ticket_id, updated_ticket_msg)
                        else:
                            print(f"⏸️ {site}: No new nodes went down. Skipping API update.")

                # SCENARIO B: Zero nodes are down for this site (100% Recovery)
                else:
                    if existing_ticket_id:
                        # Check if any node_up metric for this site transitioned to FIXED *in this exact run*
                        just_fixed = False
                        if site in alerts_by_site:
                            for srv, metrics in alerts_by_site[site]['servers'].items():
                                if 'node_up' in metrics.get('fixed_metrics', {}):
                                    just_fixed = True
                                    break
                        
                        if just_fixed:
                            print(f"📉 {site}: ALL NODES RECOVERED. Resolving ticket #{existing_ticket_id} for human review")
                            resolve_codex_incident(existing_ticket_id)
                        else:
                            # The ticket is already resolved and waiting in the queue; skip redundant API call.
                            pass
                    
        except Exception as err:
            print(f"❌ Error managing DB-Backed Node Down tickets: {err}")
        finally:
            if db_cursor_ticket: db_cursor_ticket.close()
            if db_conn_ticket: db_conn_ticket.close()


        # ✅ Send emails by type
        print("\n" + "=" * 60)
        print("📧 SENDING EMAILS")
        print("=" * 60)
        
        for site in sites_with_new_alerts:
            alert_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['new_metrics']:
                    alert_servers[server_name] = {'metrics': metrics['new_metrics']}
            
            if alert_servers:
                send_alert_email_per_site(site, alert_servers, dag_start_date, email_type='NEW')

        for site in sites_with_resend_alerts:
            alert_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['resend_metrics']:
                    alert_servers[server_name] = {'metrics': metrics['resend_metrics']}
            
            if alert_servers:
                send_alert_email_per_site(site, alert_servers, dag_start_date, email_type='RESEND')

        for site in sites_with_escalation_alerts:
            alert_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['escalation_metrics']:
                    alert_servers[server_name] = {'metrics': metrics['escalation_metrics']}
            
            if alert_servers:
                send_alert_email_per_site(site, alert_servers, dag_start_date, email_type='ESCALATION')

        for site in sites_with_fixes:
            fixed_servers = {}
            for server_name, metrics in alerts_by_site[site]['servers'].items():
                if metrics['fixed_metrics']:
                    fixed_servers[server_name] = metrics['fixed_metrics']
            
            if fixed_servers:
                send_fixed_email_per_site(site, fixed_servers, dag_start_date)

        
        # ---------------------------------------------------------
        # ACCURATE IN-MEMORY COUNTING LOGIC & SEVERITY
        # ---------------------------------------------------------
        new_count = sum(len(m['new_metrics']) for s in alerts_by_site.values() for m in s['servers'].values())
        resend_count = sum(len(m['resend_metrics']) + len(m['escalation_metrics']) for s in alerts_by_site.values() for m in s['servers'].values())
        fixed_count = sum(len(m['fixed_metrics']) for s in alerts_by_site.values() for m in s['servers'].values())
        
        # Determine status code
        status_code = 1
        exception_type = None
        
        if (new_count + resend_count) > 0:
            status_code = highest_severity_this_run # <--- Applies the Sev 1 if Node Down!
            exception_type = "AirflowAlertException"
            
            # Ultimate safety catch: Check master ticket list just to be absolutely certain
            if total_down_nodes > 0:
                status_code = 1 

        message = f"New alerts: {new_count}, Resent: {resend_count}, Fixed: {fixed_count}"

        # Log to job_log_alert
        print("\n" + "=" * 60)
        print("📋 LOGGING RESULTS")
        print("=" * 60)
        
        if (new_count + resend_count) > 0:
            print(f"Status: WARNING/CRITICAL (Sev {status_code})")
            print(f"Message: {message}")
            
            insert_job_log_alert(
                vprojname,
                dag_start_date,
                dag_end_date,
                vdag_id,
                message,
                "Infrastructure",  
                status_code,
                exception_type
            )
        else:
            print("Status: SUCCESS")
            print(f"Message: {message}")
            
            # Standard SQL insert for a PASS. Defaults to Severity = NULL.
            try:
                db_conn_success = init_db_airflow()
                db_cursor_success = db_conn_success.cursor()
                
                insert_pass_qry = """
                    INSERT INTO t_app_job_log 
                    (ProjName, DAG_StartDate, DAG_EndDate, DAG_id, Status, Message) 
                    VALUES (%s, %s, %s, %s, 'PASS', %s)
                """
                db_cursor_success.execute(insert_pass_qry, (vprojname, dag_start_date, dag_end_date, vdag_id, message))
                db_conn_success.commit()
            except Exception as e:
                print(f"Failed to log success: {e}")
            finally:
                if 'db_cursor_success' in locals(): db_cursor_success.close()
                if 'db_conn_success' in locals(): db_conn_success.close()

        print(f"\n✅ Monitoring complete. {message}")
        print("=" * 60)

    except Exception as err:
        print(f"\n❌ Error in monitor_servers_infra: {err}")
        traceback.print_exc()

        insert_job_log_alert(
            vprojname,
            dag_start_date,
            datetime.now(),
            vdag_id,
            f"DAG execution failed: {str(err)}",
            "Infrastructure",  # <--- FIXED CATEGORY STRING!
            3,
            "AirflowException"
        )

        insert_run_failures(vdag_id, dag_start_date, 'ERROR', 'DAG', 'N/A', 0, 'ERROR', str(err))
        raise
    finally:
        try:
            if db_cursor_proj:
                db_cursor_proj.close()
        except Exception:
            pass
        try:
            if db_conn_proj:
                db_conn_proj.close()
        except Exception:
            pass


