# ============== ALERT STATUS MANAGEMENT ==============
def insert_alert_status(server_name, site_name, metric_name, metric_value, threshold_warning, threshold_critical, alert_type):
    """
    Manage alert status with refined logic
    Uses buffered=True cursor to avoid MySQL connector issues
    
    Returns:
        ('NEW', dict) - New alert created
        ('UPDATED', None) - OPEN alert, still high, resend email
        ('ACKNOWLEDGED_STILL_HIGH', None) - ACK alert, metric didn't increase, no email
        ('ACKNOWLEDGED_ESCALATED', None) - ACK alert, metric increased, reopen and send escalation
        ('FIXED', dict) - Alert resolved, awaiting manual closure
        ('REOPENED', None) - CLOSED/FIXED alert re-triggered
        ('NORMAL', None) - Below threshold, no action
    """

    db_conn = None
    db_cursor = None

    try:
        db_conn = init_db_airflow()
        db_cursor = db_conn.cursor(buffered=True)

        check_qry = f"""
            SELECT alert_id, status, metric_value, last_alert_time 
            FROM {alert_status_table}
            WHERE server_name = %s
              AND metric_name = %s
              AND status IN ('OPEN', 'ACKNOWLEDGED', 'FIXED')
        """
        db_cursor.execute(check_qry, (server_name, metric_name))
        existing_alert = db_cursor.fetchone()

        # ✅ CLEAN NODE_UP LOGIC
        if metric_name == 'node_up':
            is_alert = (metric_value == 0)
            threshold_value = 1
        else:
            # Respect the GPU/CPU sustained override
            is_alert = (metric_value > threshold_warning) and (alert_type not in ['NORMAL', 'IGNORED'])
            threshold_value = threshold_warning
        
        # ================= ALERT =================
        if is_alert:

            if existing_alert:
                alert_id, status, prev_metric_value, last_alert_time = existing_alert  # Unpack all 4!

                # ✅ OPEN → RESEND (Throttle check)
                if status == 'OPEN':
                    update_qry = f"""
                        UPDATE {alert_status_table}
                        SET metric_value = %s,
                            threshold = %s
                        WHERE alert_id = %s
                    """
                    db_cursor.execute(update_qry, (metric_value, threshold_value, alert_id))
                    db_conn.commit()

                    print(f"🔄 UPDATED (OPEN): {server_name} - {metric_name} = {metric_value} - CHECKING THROTTLE")
                    return ('UPDATED', {'alert_id': alert_id, 'last_alert_time': last_alert_time})

                # ✅ ACKNOWLEDGED
                elif status == 'ACKNOWLEDGED':
                    metric_increased = prev_metric_value and metric_value > prev_metric_value

                    if metric_increased:
                        update_qry = f"""
                            UPDATE {alert_status_table}
                            SET metric_value = %s,
                                threshold = %s,
                                status = 'OPEN',
                                acknowledged_by = NULL,
                                acknowledged_at = NULL,
                                last_alert_time = %s
                            WHERE alert_id = %s
                        """
                        db_cursor.execute(update_qry, (metric_value, threshold_value, datetime.now(), alert_id))
                        db_conn.commit()

                        return ('ACKNOWLEDGED_ESCALATED', None)

                    else:
                        update_qry = f"""
                            UPDATE {alert_status_table}
                            SET metric_value = %s,
                                threshold = %s
                            WHERE alert_id = %s
                        """
                        db_cursor.execute(update_qry, (metric_value, threshold_value, alert_id))
                        db_conn.commit()

                        return ('ACKNOWLEDGED_STILL_HIGH', None)

                # ✅ FIXED -> REOPEN (Spiked again while waiting for manual close)
                elif status == 'FIXED':
                    update_qry = f"""
                        UPDATE {alert_status_table}
                        SET metric_value = %s,
                            threshold = %s,
                            status = 'OPEN',
                            last_alert_time = %s
                        WHERE alert_id = %s
                    """
                    db_cursor.execute(update_qry, (metric_value, threshold_value, datetime.now(), alert_id))
                    db_conn.commit()

                    print(f"🔴 RE-ESCALATED (from FIXED): {server_name} - {metric_name} = {metric_value}")
                    return ('REOPENED', {
                        'server_name': server_name,
                        'metric_name': metric_name,
                        'metric_value': metric_value
                    })

            else:
                # ✅ CHECK CLOSED
                check_closed = f"""
                    SELECT alert_id FROM {alert_status_table}
                    WHERE server_name = %s
                      AND metric_name = %s
                      AND status = 'CLOSED'
                """
                db_cursor.execute(check_closed, (server_name, metric_name))
                closed_alert = db_cursor.fetchone()

                insert_qry = f"""
                    INSERT INTO {alert_status_table}
                    (server_name, site_name, dag_id, alert_type, metric_name, metric_value, threshold, status, first_alert_time, last_alert_time)
                    VALUES (%s, %s, %s, 'INFRA', %s, %s, %s, 'OPEN', %s, %s)
                """

                if closed_alert:
                    status_type = 'REOPENED'
                    print(f"🔴 REOPENED: {server_name}")
                else:
                    status_type = 'NEW'
                    print(f"🆕 NEW ALERT: {server_name}")

                db_cursor.execute(insert_qry, (
                    server_name,
                    site_name,
                    vdag_id,
                    metric_name,
                    metric_value,
                    threshold_value,
                    datetime.now(),
                    datetime.now()
                ))
                db_conn.commit()

                return (status_type, {
                    'server_name': server_name,
                    'metric_name': metric_name,
                    'metric_value': metric_value
                })

        # ================= NORMAL / IGNORED =================
        else:
            if existing_alert:
                alert_id, status, _, _ = existing_alert

                # ONLY auto-fix if it's currently OPEN or ACKNOWLEDGED
                if status in ['OPEN', 'ACKNOWLEDGED']:
                    
                    if alert_type == 'NORMAL':
                        fix_qry = f"""
                            UPDATE {alert_status_table}
                            SET metric_value = %s,
                                threshold = %s,
                                status = 'FIXED',
                                last_alert_time = %s
                            WHERE alert_id = %s
                        """
                        db_cursor.execute(fix_qry, (metric_value, threshold_value, datetime.now(), alert_id))
                        db_conn.commit()

                        print(f"✅ FIXED: {server_name} - {metric_name} = {metric_value}")
                        return ('FIXED', {
                            'server_name': server_name,
                            'metric_name': metric_name,
                            'metric_value': metric_value
                        })
                    
                    elif alert_type == 'IGNORED':
                        print(f"⏸️  Alert kept OPEN (transient spike during active alert): {server_name}")
                        return ('IGNORED', None)
                        
                elif status == 'FIXED':
                    return ('NORMAL', None)

            return ('NORMAL', None)

    except Exception as err:
        print(f"❌ Error in insert_alert_status: {err}")
        traceback.print_exc()
        raise

    finally:
        if db_cursor:
            db_cursor.close()
        if db_conn:
            db_conn.close()


def poll_codex_for_closures():
    """
    Two-Way Sync: Queries DB for 'FIXED' alerts waiting on a human. 
    Polls the Codex API to see if a human changed it to 'Closed'.
    If yes, updates the Airflow DB to 'CLOSED' and unlinks the ticket.
    """
    try:
        conn = init_db_airflow()
        cursor = conn.cursor(buffered=True)
        
        # Find all FIXED alerts that are still waiting for a human
        cursor.execute(f"""
            SELECT server_name, metric_name, ticket_artifact_id 
            FROM {alert_status_table} 
            WHERE status = 'FIXED' AND ticket_artifact_id IS NOT NULL
        """)
        rows = cursor.fetchall()
        
        if not rows:
            print("✔️ No FIXED tickets awaiting human closure check.")
            return
            
        headers = {
            'Content-type': 'application/json',
            'X-Auth-AccessKey': Variable.get("codex_api_key") 
        }
        
        for row in rows:
            server_name, metric_name, ticket_id = row
            
            # Fetch ticket details directly from Codex
            url = f'https://codex.cro.st.com/api/artifacts/{ticket_id}'
            response = requests.get(url, headers=headers, verify=False)
            
            if response.status_code == 200:
                artifact = response.json()
                # Safely extract the status field
                status = artifact.get('status', '').lower()
                
                # If the human closed it in Codex!
                if status == 'closed':
                    print(f"📉 TICKETING: Human closure detected in Codex for artifact #{ticket_id} ({server_name} - {metric_name}). Updating DB to CLOSED.")
                    
                    # 1. Update the Active Status table (Surgical update using exact ticket_id)
                    cursor.execute(f"""
                        UPDATE {alert_status_table} 
                        SET status = 'CLOSED', ticket_artifact_id = NULL, closed_at = %s 
                        WHERE server_name = %s 
                          AND metric_name = %s 
                          AND ticket_artifact_id = %s 
                          AND status = 'FIXED'
                    """, (datetime.now(), server_name, metric_name, ticket_id))
                    
                    # 2. Update the Historical Infra table (Surgical update using exact DAG_id)
                    cursor.execute(f"""
                        UPDATE {alert_infra_table}
                        SET Alert_Status = 'CLOSED'
                        WHERE ServerName = %s 
                          AND Metric_Name = %s 
                          AND DAG_id = %s 
                          AND Alert_Status = 'FIXED'
                    """, (server_name, metric_name, vdag_id))
                    
                    conn.commit()
                else:
                    print(f"⏳ TICKETING: Artifact #{ticket_id} is still '{status}' in Codex. Waiting for human to close.")
            else:
                print(f"⚠️ Failed to fetch status for artifact #{ticket_id}. Status Code: {response.status_code}")
                
    except Exception as e:
        print(f"❌ Failed to poll Codex for closures: {e}")
    finally:
        if 'cursor' in locals(): cursor.close()
        if 'conn' in locals(): conn.close()


