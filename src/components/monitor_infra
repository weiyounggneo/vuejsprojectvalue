def init_db_airflow():
    """Connect to Airflow monitoring database"""
    try:
        conn_details = BaseHook.get_connection('airflow_monitoring_db')
        conn = mysql.connector.connect(
            host=conn_details.host,
            port=conn_details.port,
            user=conn_details.login,
            password=conn_details.password,
            database=conn_details.schema
        )
        return conn if conn.is_connected() else None
    except Exception as err:
        print(f"❌ Database connection error: {err}")
        raise


def get_site_from_server_name(server_name):
    """Extract site name from server name prefix (first 3 characters)"""
    site_mapping = {
        'mua': 'MUAR',
        'kir': 'MALTA',
        'b2k': 'BOUSKOURA',
        'szs': 'SHENZHEN',
        'tpy': 'TOA PAYOH',
        'cal': 'CALAMBA',
    }
    prefix = server_name[:3].lower()
    return site_mapping.get(prefix, "UNKNOWN")

def is_gpu_persistently_high(server_name, metric_name, threshold, db_conn):
    """
    Check if GPU usage exceeded threshold for last 6 records
    """
    try:
        cursor = db_conn.cursor(buffered=True)

        query = f"""
            SELECT metric_value
            FROM {server_metrics_table}
            WHERE instance = %s
              AND metric_name = %s
            ORDER BY timestamp DESC
            LIMIT 6
        """

        cursor.execute(query, (server_name, metric_name))
        rows = cursor.fetchall()

        cursor.close()

        # Not enough data → don't alert
        if len(rows) < 6:
            return False

        # Check all last 6 values > threshold
        return all(row[0] > threshold for row in rows)

    except Exception as err:
        print(f"❌ Error checking GPU persistence: {err}")
        return False

def is_cpu_persistently_high(server_name, metric_name, threshold, db_conn):
