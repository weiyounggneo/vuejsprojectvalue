def ping_server(hostname):
    """Pings a server to check if it is reachable on the network."""
    print(f"[*] Executing Tool: ping_server on {hostname}")
    command = ['ping', '-c', '4', hostname] # Changed to -c for Linux environments
    try:
        output = subprocess.check_output(command, stderr=subprocess.STDOUT, universal_newlines=True)
        return f"SUCCESS: Server {hostname} is reachable."
    except subprocess.CalledProcessError:
        return f"FAILED: Server {hostname} is unreachable."

def query_database(query_string, db_prefix="DB"):
    """Executes a read-only SELECT query on a dynamically selected database."""
    print(f"[*] Executing Tool: query_database on {db_prefix}_NAME -> {query_string}")
    
    # Security check: Only allow SELECT queries
    if not query_string.strip().upper().startswith("SELECT"):
        return "FAILED: Security restriction. Only SELECT queries are allowed."
        
    # Dynamically fetch credentials (falls back to main RCA DB if specific ones aren't found)
    host = os.getenv(f"{db_prefix}_HOST") or os.getenv('DB_HOST')
    port = int(os.getenv(f"{db_prefix}_PORT") or os.getenv('DB_PORT', 3306))
    user = os.getenv(f"{db_prefix}_USER") or os.getenv('DB_USER')
    password = os.getenv(f"{db_prefix}_PASS") or os.getenv('DB_PASSWORD')
    database = os.getenv(f"{db_prefix}_NAME") or os.getenv('DB_NAME')
        
    try:
        conn = mysql.connector.connect(
            host=host,
            port=port,
            user=user,
            password=password,
            database=database
        )
        cursor = conn.cursor(dictionary=True)
        cursor.execute(query_string)
        results = cursor.fetchall()
        conn.close()
        
        if not results:
            return "SUCCESS: Query executed, but returned 0 rows."
            
        return f"SUCCESS: Extracted Data -> {results[:5]}"
        
    except Exception as e:
        return f"FAILED: Database query failed on {database}. Error: {e}"

def run_ssh_command(hostname, command):
    """Executes a bash command on a remote Linux server via SSH with dynamic credentials."""
    print(f"[*] Executing Tool: run_ssh_command on {hostname} -> {command}")
    
    # NEW: Check if the target is an IP address or a hostname
    if hostname[0].isdigit():
        # IP Address: '10.56.12.34' -> '10_56_12_34'
        short_name = hostname.replace('.', '_')
    else:
        # Hostname: 'kirsx00317.kir.st.com' -> 'KIRSX00317'
        short_name = hostname.split('.')[0].upper()
    
    # Dynamically look up the specific environment variables
    ssh_user = os.getenv(f"{short_name}_USER")
    ssh_pass = os.getenv(f"{short_name}_PASS")
    
    # If specific credentials don't exist in .env, use the default service account
    if not ssh_user or not ssh_pass:
        print(f"[*] Specific credentials for {short_name} not found. Using default account.")
        ssh_user = os.getenv('DEFAULT_LINUX_USER')
        ssh_pass = os.getenv('DEFAULT_LINUX_PASS')
    
    ssh = paramiko.SSHClient()
    ssh.set_missing_host_key_policy(paramiko.AutoAddPolicy())
    
    try:
        ssh.connect(
            hostname=hostname,
            username=ssh_user,
            password=ssh_pass,
            timeout=5
        )
        stdin, stdout, stderr = ssh.exec_command(command)
        output = stdout.read().decode().strip()
        error = stderr.read().decode().strip()
        
        ssh.close()
        
        if error:
            return f"FAILED: Command executed but returned error: {error}"
        return f"SUCCESS: Output -> {output}"
        
    except paramiko.AuthenticationException:
        return f"AUTH_FAILURE: Invalid SSH credentials for {hostname}."
    except Exception as e:
        return f"SSH_FAILURE: Could not connect to {hostname}. Error: {e}"

def check_port(hostname, port):
    """Checks if a specific TCP port is open."""
    print(f"[*] Executing Tool: check_port on {hostname}:{port}")
    try:
        sock = socket.create_connection((hostname, int(port)), timeout=5)
        sock.close()
        return f"SUCCESS: Port {port} on {hostname} is open and accepting connections."
    except Exception as e:
        return f"FAILED: Port {port} on {hostname} is closed or blocked. Error: {e}"

def verify_smb_connectivity(target_ip):
    """Tests if the Windows host is reachable over SMB (Port 445) natively from Linux."""
    print(f"[*] Executing Tool: verify_smb_connectivity on {target_ip}")
    user = os.getenv('WINDOWS_ADMIN_USER')
    password = os.getenv('WINDOWS_ADMIN_PASS')
    try:
        # If the network or machine is down, this raises an exception immediately
        smbclient.register_session(target_ip, username=user, password=password, connection_timeout=5)
        smbclient.delete_session(target_ip)
        return f"SUCCESS: Windows host {target_ip} is reachable over SMB. Network path is healthy."
    except SMBException as e:
        return f"AUTH_ISSUE: Host is reachable, but credentials failed: {e}"
    except Exception as e:
        return f"NETWORK_DOWN: Host {target_ip} unreachable over Port 445. Windows mapping is definitively down: {e}"

def verify_ip_reachability(ip_address):
    """
    Tests if an IP is online using Ping, with a TCP socket fallback if ICMP is blocked.
    """
    print(f"[*] Executing Tool: verify_ip_reachability on {ip_address}")
    
    # 1. Try a standard ICMP Ping (Linux format: 2 packets, 2-second timeout)
    try:
        subprocess.check_output(['ping', '-c', '2', '-W', '2', ip_address], 
                                stderr=subprocess.STDOUT, 
                                universal_newlines=True)
        return f"SUCCESS: IP {ip_address} is online and responding to Ping."
    except subprocess.CalledProcessError:
        pass # Ping failed or is blocked by a firewall. Proceed to TCP fallback.
        
    # 2. TCP Fallback: Check if common manufacturing ports are alive
    # 445 (SMB), 135 (RPC), 5900 (VNC)
    common_ports = [445, 135, 5900]
    
    for port in common_ports:
        try:
            sock = socket.create_connection((ip_address, port), timeout=2)
            sock.close()
            return f"SUCCESS: IP {ip_address} is online. (Ping is blocked, but Port {port} responded)."
        except Exception:
            continue # Try the next port
            
    return f"FAILED: IP {ip_address} is completely unreachable via Ping and standard TCP network ports."

def check_http_endpoint(url):
    """Checks if a REST API or web dashboard is returning a 200 OK status."""
    print(f"[*] Executing Tool: check_http_endpoint on {url}")
    try:
        response = requests.get(url, timeout=5)
        return f"SUCCESS: Endpoint returned HTTP {response.status_code}"
    except requests.exceptions.RequestException as e:
        return f"FAILED: Endpoint {url} is completely unreachable. Error: {e}"

def check_db_connection(target_host, port):
    """Tests a raw MySQL/TCP connection using existing credentials."""
    print(f"[*] Executing Tool: check_db_connection on {target_host}:{port}")
    try:
        conn = mysql.connector.connect(
            host=target_host,
            port=int(port),
            user=os.getenv('DB_USER'),
            password=os.getenv('DB_PASSWORD'),
            connect_timeout=5
        )
        conn.close()
        return f"SUCCESS: Database at {target_host}:{port} is up and accepting credentials."
    except Exception as e:
        return f"FAILED: Database connection failed. Error: {e}"
        
