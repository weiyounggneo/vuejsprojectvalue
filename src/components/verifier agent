def run_verifier_agent(incident_error_message, proposed_rca, proposed_fix, raw_db_sop):
    """
    Runs an iterative investigation loop. The AI can use multiple tools 
    sequentially based on the SOP before delivering a final Investigative Dossier.
    """
    print("\n" + "="*60)
    print("[*] Starting Verifier Agent (Investigator Mode)")
    print("="*60)

    investigation_log = ""
    max_steps = 3  # Prevent infinite loops

    for step in range(1, max_steps + 1):
        print(f"\n--- Investigation Step {step} ---")
        
        api_input = f"""
        CURRENT INCIDENT LOG:
        {incident_error_message}

        AI PROPOSED ROOT CAUSE & FIX:
        {proposed_rca}
        {proposed_fix}

        STRICT INVESTIGATION SOP (FROM DATABASE):
        {raw_db_sop}

        INVESTIGATION HISTORY (Evidence gathered so far):
        {investigation_log if investigation_log else "None. This is step 1."}
        """

        api_prompt = """
        You are an Investigative Verifier Agent. Read the SOP, the error, and the Investigation History. Decide if you need to run a tool to gather more evidence, OR if you have enough evidence to output the final conclusion.

        CRITICAL RULES: 
        1. SEQUENTIAL EXECUTION: You MUST execute the SOP steps in exact chronological order.
        2. STRICT COMMANDS: If the SOP provides a specific command, execute it EXACTLY as written.
        3. FINAL REPORTING: When you have finished the SOP, set "is_final": true. You MUST provide a "confidence_score" (1-100) and a list of "completed_steps" summarizing what you actually checked from the SOP.
        
        AVAILABLE TOOLS:
        1. "verify_smb_connectivity" - target (IP).
        2. "verify_ip_reachability" - target.
        3. "check_port" - target and port.
        4. "check_http_endpoint" - target (URL).
        5. "check_db_connection" - target and port.
        6. "run_ssh_command" - target (Hostname/IP) and command.
        7. "fetch_mlflow_metrics" - target (Model Name).
        8. "query_database" - target (Database Prefix) and query.

        IMPORTANT CONSTRAINT:
        Return ONLY a valid JSON object. 
        If you need to use a tool, set "is_final": false.
        If you have finished, set "is_final": true and fill out the final_report, confidence_score, and completed_steps.
        Do not use special unicode math symbols like ≤ or ≥. Always use standard keyboard characters like <= and >=.
        
        JSON SCHEMA:
        {
            "thought": "Explain your logic: what evidence do you have, and what are you doing next?",
            "is_final": false,
            "tool": "tool_name",
            "target": "target_data",
            "port": 445,
            "command": "The bash command to run if using run_ssh_command, otherwise leave empty.",
            "query": "The exact SQL SELECT statement if using query_database, otherwise leave empty.",
            "confidence_score": 95, 
            "completed_steps": ["Step 1: Checked SSH process count (Result: 2)", "Step 2: Evaluated outcome as healthy"],
            "final_report": "If is_final is true, write the final Investigative Dossier."
        }
        """

        headers = {"Authorization": "application/json", "Content-Type": "application/json"}
        payload = {"input": api_input, "prompt": api_prompt}

        try:
            response = requests.post(LLM_URL, headers=headers, json=payload, timeout=120)
            if not response.ok:
                return f"LLM API Failed: {response.status_code}"
                
            llm_response = response.json().get("completion", "")
            command = json.loads(llm_response.strip())
            
            print(f"[*] AI Thought: {command.get('thought')}")
            
            # ==========================================================
            # If the AI decides the investigation is complete
            # ==========================================================
            if command.get("is_final"):
                print("[*] AI has concluded the investigation.")
                
                # Extract the new fields
                raw_report = command.get("final_report", "No report provided.")
                confidence = command.get("confidence_score", "N/A")
                steps = command.get("completed_steps", [])
                
                # Format the checklist nicely using Markdown
                checklist_markdown = "\n".join([f"- [x] {s}" for s in steps]) if steps else "- [ ] No steps recorded."
                
                # Build the final string to inject into the database
                final_output = (
                    f"{raw_report}\n\n"
                    f"###  AI Confidence Score: {confidence}%\n\n"
                    f"###  SOP Execution Checklist:\n{checklist_markdown}"
                )
                
                return final_output
                
            # ==========================================================
            # Otherwise, execute the requested tool
            # ==========================================================
            tool = command.get("tool")
            target = command.get("target")
            port = command.get("port")
            ssh_cmd = command.get("command")
            sql_query = command.get("query")
            
            if tool == "ping_server":
                result = ping_server(target)
            elif tool == "check_port":
                result = check_port(target, port)
            elif tool == "verify_smb_connectivity":
                result = verify_smb_connectivity(target)
            elif tool == "check_http_endpoint":
                result = check_http_endpoint(target)
            elif tool == "check_db_connection":
                result = check_db_connection(target, port)
            elif tool == "fetch_mlflow_metrics":
                result = fetch_mlflow_metrics(target)
            elif tool == "run_ssh_command":       
                result = run_ssh_command(target, ssh_cmd)
            elif tool == "query_database":
                result = query_database(sql_query, db_prefix=target)
            else:
                result = f"Error: LLM hallucinated an unknown tool '{tool}'"
                
            print(f"[*] Tool Result: {result}")
            
            # Append the result to the log for the AI to read on the next loop
            investigation_log += f"\nStep {step} - Used {tool} on {target}: {result}"

        except json.JSONDecodeError:
            print("[!] Failed to parse LLM output as JSON.")
            return "VERIFICATION FAILED: LLM did not return strict JSON."
        except Exception as e:
            return f"CRITICAL ERROR: {e}"

    # If the loop maxes out before 'is_final' becomes true
    return f"INVESTIGATION TIMEOUT (Max steps reached). Evidence gathered:\n{investigation_log}"
